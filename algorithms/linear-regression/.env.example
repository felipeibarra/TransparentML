# ========================================
# Variables de Entorno - Tarea 1 ML
# ========================================

# API Configuration
MODEL_PATH=/app/models
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=8000

# Training Configuration
DATA_PATH=/app/data
RESULTS_PATH=/app/results
MODEL_OUTPUT_PATH=/app/models

# Training Hyperparameters
TRAIN_TEST_SPLIT=0.2
RANDOM_STATE=42
N_JOBS=-1

# Jupyter Configuration
JUPYTER_TOKEN=
JUPYTER_PASSWORD=
JUPYTER_ENABLE_LAB=yes

# Database (opcional - para tracking de experimentos)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ml_tracking
# DB_USER=mluser
# DB_PASSWORD=changeme

# Monitoring (opcional)
PROMETHEUS_ENABLED=true
METRICS_PORT=9090

# Logging
LOG_FORMAT=json
LOG_FILE=/app/logs/app.log
